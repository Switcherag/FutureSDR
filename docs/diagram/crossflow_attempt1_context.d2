title: Cross Flowgraph Example - Attempt 1 (System Context)

direction: right

operator: {
  label: "Operator"
  shape: person
}

udp_client: {
  label: "UDP Client\n(e.g., netcat)"
  shape: rectangle
}

host: {
  label: "cross_fg process"

  runtime: {
    label: "FutureSDR Runtime"
  }

  controller: {
    label: "FlowgraphController"
  }

  plugin_registry: {
    label: "PluginRegistry\n(lib*_plugin.so)"
  }

  fg0: {
    label: "FG0 Permanent\n(flows/fg0.toml)"
  }

  fg1: {
    label: "FG1 Swappable\n(flow_a.toml | flow_b.toml | flow_chain.toml)"
  }

  bridge: {
    label: "Auto Bridge Channel\nArc<Mutex<VecDeque<u8>>>"
  }
}

operator -> udp_client: "sends -s / Q"
udp_client -> controller: "UDP :7878 commands"
controller -> plugin_registry: "ensure_loaded(plugin)"
controller -> runtime: "start/terminate flowgraphs"
controller -> fg0: "build and run"
controller -> fg1: "build, run, swap"
fg0 -> bridge: "out port (u8)"
bridge -> fg1: "in port (u8)"
controller -> fg0: "selector callback output_index"
