title: Cross Flowgraph Example - Attempt 3 (Controller Build Pipeline)

direction: down

builder: "FlowgraphController::builder(default_plugin_dir())"
add_perm: ".add_permanent(\"flows/fg0.toml\")"
add_swap: ".add_swappable(\"flows/flow_a.toml\")"
connect: ".connect(0, \"out\", 1, \"in\")"
udp: ".udp_port(7878)"
run: ".run()"

precompute: "Build channels map\nkey format: <fg_idx>:<port_id>"
load_toml: "Parse FlowgraphDef TOML"
preload: "Pre-load plugins via PluginRegistry::ensure_loaded"

build_fg: {
  label: "build_flowgraph_full(fg_idx, toml)"

  step1: "1) create Flowgraph"
  step2: "2) add user blocks (plugin.prepare(config))"
  step3: "3) connect user connections"
  step4: "4) for each [[ports]] inject bridge blocks"

  out_port_case: {
    label: "if direction=out"
    parse_src: "parse src=block.port"
    inject_sink: "add_bridge_sink by type\nU8/F32/C32"
    conn_sink: "connect src -> bridge_sink.input"
    parse_src -> inject_sink -> conn_sink
  }

  in_port_case: {
    label: "if direction=in"
    parse_dst: "parse dst=block.port"
    inject_source: "add_bridge_source by type\nU8/F32/C32"
    conn_src: "connect bridge_source.output -> dst"
    parse_dst -> inject_source -> conn_src
  }

  step4 -> out_port_case
  step4 -> in_port_case
}

start_perm: "start permanent FGs\ncache selector info"
activate_sel: "activate_selectors()\nset output_index=1"
start_swap: "start swappable FGs"
loop: "UDP command loop"

builder -> add_perm -> add_swap -> connect -> udp -> run
run -> precompute -> load_toml -> preload -> build_fg
build_fg -> start_perm -> activate_sel -> start_swap -> loop
