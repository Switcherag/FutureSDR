title: Cross Flowgraph Example - Attempt 5 (Control Plane and State Model)

direction: right

state: {
  label: "FlowgraphController internal state"

  registry: "registry: PluginRegistry"
  channels: "channels: HashMap<String, Arc<Mutex<VecDeque<u8>>>>"
  connections: "connections: Vec<Connection>"
  perm_handles: "perm_handles: HashMap<usize, FlowgraphHandle>"
  selector_infos: "selector_infos: Vec<SelectorInfo>"
  swap_states: "swap_states: HashMap<usize, SwappableState>"
}

keys: {
  label: "Channel key contract"
  k1: "from key: <from_fg>:<from_port>"
  k2: "to key:   <to_fg>:<to_port>"
  shared: "both map to same Arc<Mutex<VecDeque<u8>>>"
  k1 -> shared
  k2 -> shared
}

selector_logic: {
  label: "Selector behavior"
  s1: "default config in fg0: DropAll"
  s2: "activate_selectors(): output_index=1"
  s3: "during swap: output_index=0"
  s4: "after swap/restore: output_index=1"
  s1 -> s2 -> s3 -> s4
}

udp_api: {
  label: "UDP API (:7878)"
  c1: "-s <path.toml>"
  c2: "-s <fg_index> <path.toml>"
  c3: "Q"
}

state.connections -> keys
state.selector_infos -> selector_logic
udp_api.c1 -> state.swap_states: "swap first swappable"
udp_api.c2 -> state.swap_states: "swap explicit fg"
udp_api.c3 -> state.perm_handles: "shutdown_all()"
udp_api.c3 -> state.swap_states: "shutdown_all()"
