title: Cross Flowgraph Example - Attempt 2 (Data Plane Topology)

direction: right

fg0: {
  label: "FG0 Permanent (flows/fg0.toml)"

  src: "null_source_plugin"
  thr: "throttle_plugin\nconfig: 1.0"
  sel: "selector_1_2_plugin\nconfig: DropAll"
  snk: "null_sink_plugin"
  out_port: "port out\nsrc=sel.outputs[1]\nrouter=sel\ntype=u8"

  src -> thr: "u8 stream"
  thr -> sel: "u8 stream"
  sel -> snk: "outputs[0]"
  sel -> out_port: "outputs[1]"
}

channel: {
  label: "Shared channel key\n0:out <-> 1:in"
  shape: cylinder
}

fg1_a: {
  label: "FG1 Swappable - flow_a.toml"
  in_port_a: "port in\ndst=sink.input\ntype=u8"
  sink_a: "print_sink_plugin\nconfig: Flow A"
  in_port_a -> sink_a
}

fg1_b: {
  label: "FG1 Swappable - flow_b.toml"
  in_port_b: "port in\ndst=sink.input\ntype=u8"
  sink_b: "print_sink_plugin\nconfig: Flow B"
  in_port_b -> sink_b
}

fg1_chain: {
  label: "FG1 Swappable - flow_chain.toml"
  in_port_c: "port in\ndst=passthrough.input\ntype=u8"
  copy: "copy_plugin"
  sink_c: "print_sink_plugin\nconfig: Chain"
  in_port_c -> copy
  copy -> sink_c
}

out_bridge: "auto BridgeSinkU8"
in_bridge: "auto BridgeSourceU8"

fg0.out_port -> out_bridge: "auto injected"
out_bridge -> channel
channel -> in_bridge
in_bridge -> fg1_a.in_port_a: "active when flow_a loaded"
in_bridge -> fg1_b.in_port_b: "active when flow_b loaded"
in_bridge -> fg1_chain.in_port_c: "active when flow_chain loaded"
