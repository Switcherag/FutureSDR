title: Cross Flowgraph Example - Attempt 7 (Bridge Memory and Type Semantics)

direction: right

shared: {
  label: "Shared transport primitive"
  buf: "Arc<Mutex<VecDeque<u8>>>"
  cap: "soft cap: MAX_BRIDGE_BYTES = 32768"
  policy: "on overflow: pop_front() then push_back()\n(oldest bytes dropped)"
}

u8_path: {
  label: "U8 path"
  sink: "BridgeSinkU8\ninput: u8"
  src: "BridgeSourceU8\noutput: u8"
  sink -> shared.buf: "push raw bytes"
  shared.buf -> src: "drain bytes"
}

f32_path: {
  label: "F32 path"
  sink: "BridgeSinkF32\ninput: f32"
  src: "BridgeSourceF32\noutput: f32"
  ser: "reinterpret f32 slice as bytes\n4 bytes/sample"
  deser: "reconstruct output bytes\nto_produce = min(buf.len/4, out.len)"
  sink -> ser -> shared.buf
  shared.buf -> deser -> src
}

c32_path: {
  label: "Complex32 path"
  sink: "BridgeSinkC32\ninput: Complex32"
  src: "BridgeSourceC32\noutput: Complex32"
  ser: "reinterpret Complex32 slice as bytes\n8 bytes/sample"
  deser: "reconstruct output bytes\nto_produce = min(buf.len/8, out.len)"
  sink -> ser -> shared.buf
  shared.buf -> deser -> src
}

sleep: "if no samples available:\nio.block_on(Timer::after(50ms))"

u8_path.src -> sleep
f32_path.src -> sleep
c32_path.src -> sleep
shared.cap -> shared.policy
