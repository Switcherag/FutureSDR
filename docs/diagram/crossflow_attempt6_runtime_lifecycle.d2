title: Cross Flowgraph Example - Attempt 6 (Runtime and Flowgraph Lifecycle)

direction: down

start: "RuntimeHandle::start(fg)"
channel: "create fg_inbox channel\n(queue_size from config)"
spawn: "spawn run_flowgraph(fg, scheduler, inbox)"
wait_init: "oneshot wait for initialization result"

init_phase: {
  label: "run_flowgraph initialization phase"
  i1: "collect block inboxes + ids"
  i2: "scheduler.run_flowgraph(blocks, main_channel)"
  i3: "send BlockMessage::Initialize to all blocks"
  i4: "wait FlowgraphMessage::Initialized / BlockError"
  i5: "queue unrelated messages during init"
  i6: "send BlockMessage::Notify to start running"
  i7: "replay queued messages to main inbox"
  i8: "initialized.send(Ok(()))"
  i9: "if any block_error: enqueue Terminate"
  i1 -> i2 -> i3 -> i4 -> i5 -> i6 -> i7 -> i8 -> i9
}

main_loop: {
  label: "run_flowgraph main loop"
  m1: "handle BlockCall -> forward to block inbox"
  m2: "handle BlockCallback -> oneshot reply Pmt"
  m3: "handle BlockDescription / FlowgraphDescription"
  m4: "handle BlockDone / BlockError"
  m5: "handle Terminate -> send BlockMessage::Terminate once"
  m6: "exit when active_blocks == 0"
  m7: "if block_error => return RuntimeError"
  m1 -> m2 -> m3 -> m4 -> m5 -> m6 -> m7
}

terminate_wait: "FlowgraphHandle::terminate_and_wait()\npolls until inbox closed"

start -> channel -> spawn -> wait_init -> init_phase -> main_loop -> terminate_wait
