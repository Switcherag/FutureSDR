title: Cross Flowgraph - Attempt 11 (Operational Playbook)

direction: down

boot: {
  label: "Boot sequence"
  b1: "runtime::init()"
  b2: "FlowgraphController::builder(plugin_dir)"
  b3: "declare permanent + swappable TOMLs"
  b4: "declare connect() edges"
  b5: "run()"
  b1 -> b2 -> b3 -> b4 -> b5
}

steady: {
  label: "Steady-state"
  s1: "permanent FG emits stream"
  s2: "bridge sink writes channel"
  s3: "bridge source feeds swappable FG"
  s4: "swappable sink prints/consumes"
  s1 -> s2 -> s3 -> s4
}

control: {
  label: "Control inputs (UDP :7878)"
  c1: "-s path.toml"
  c2: "-s fg_idx path.toml"
  c3: "Q"
}

maintenance: {
  label: "Engineer actions"
  m1: "prepare new TOML"
  m2: "verify plugin .so presence"
  m3: "send swap command"
  m4: "watch logs for restore/error"
  m5: "iterate safely"
  m1 -> m2 -> m3 -> m4 -> m5
}

failure_paths: {
  label: "Failure handling"
  f1: "plugin load failure"
  f2: "TOML parse/build failure"
  f3: "flowgraph start failure"
  f4: "automatic restore previous flow"
  f5: "selectors unparked after restore"
  f1 -> f4
  f2 -> f4
  f3 -> f4 -> f5
}

boot.b5 -> steady.s1
control.c1 -> maintenance.m3
control.c2 -> maintenance.m3
control.c3 -> "shutdown_all()"
maintenance.m4 -> failure_paths.f2
maintenance.m4 -> failure_paths.f3
